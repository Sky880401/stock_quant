# LINE Bot 配置
# 從 LINE Developers Console 獲取: https://developers.line.biz/zh-hant/

LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# GitHub 配置
# 建立 GitHub Personal Access Token: https://github.com/settings/tokens
# 需要權限: repo, issues
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_username/your_repo

# 管理員端點 (/feedback/stats, /feedback/list) 認證金鑰
# 請產生隨機字串: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change_me_to_a_random_string

# 生產環境
ENVIRONMENT=development  # 或 production
DEBUG=false  # 切勿在生產環境開啟 (Werkzeug debugger 可被遠端執行程式碼)
