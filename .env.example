# ── Discord（主要平台，啟動 discord_runner.py 必填）──────────
# Discord Developer Portal → Applications → Bot → Reset Token
# 需在 Bot 設定開啟 MESSAGE CONTENT INTENT（程式有用 message_content）
DISCORD_TOKEN=your_discord_bot_token_here

# ── AI 推論（ai_runner / ai_engine 用）────────────────────────
# 兩者擇一或都填，看 ai_runner.py 實際走哪個 provider
OPENAI_API_KEY=your_openai_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── LINE（輔助平台，Discord-only 部署可留空）──────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── GitHub（若用 issue 回報/眾包功能）─────────────────────────
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_username/your_repo

# ── 環境 ──────────────────────────────────────────────────────
ENVIRONMENT=development   # 或 production
DEBUG=false  # 切勿在生產環境開啟 (Werkzeug debugger 可被遠端執行程式碼)

# 管理員端點 (/feedback/stats, /feedback/list) 認證金鑰
# 請產生隨機字串: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change_me_to_a_random_string

# 每日選股排行自動推播的目標頻道 ID(持久化，重啟不掉；留空則需在頻道用 !bind)
RANK_PUSH_CHANNEL_ID=
